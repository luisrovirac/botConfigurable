# Copia a .env y ajusta. botConfigurable.bat lo crea solo, apuntando a los contenedores
# (db en lugar de localhost) y con una SECRET_KEY aleatoria.
# La app valida esto al arrancar y no arranca si falta algo obligatorio.

APP_NAME=botConfigurable
# development | test | staging | production. Fuera de development/test se exige SECRET_KEY fuerte.
ENVIRONMENT=development
DEBUG=false
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Base de datos ---
# La app se conecta con un rol sin privilegios (sujeto a RLS).
DATABASE_URL=postgresql+asyncpg://bot_app:bot_app_dev@localhost:5432/botconfigurable
# Dueno de las tablas: solo para migraciones (alembic).
DATABASE_OWNER_URL=postgresql+asyncpg://user:password@localhost:5432/botconfigurable
# La contrasena de bot_app la define APP_DB_PASSWORD al levantar docker compose
# (por defecto bot_app_dev) y debe coincidir con la de DATABASE_URL.

# --- Autenticacion ---
# Fuera de development/test: al menos 32 caracteres aleatorios (openssl rand -hex 32).
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- WhatsApp Cloud API (Meta) ---
# Obligatorios. En desarrollo basta cualquier valor; el simulador firma con WHATSAPP_APP_SECRET.
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret
# fake: no llama a Meta, solo registra el envio (desarrollo sin credenciales).
# real: envia por la Graph API; requiere WHATSAPP_ACCESS_TOKEN.
WHATSAPP_SEND_MODE=fake
WHATSAPP_ACCESS_TOKEN=
META_API_VERSION=v21.0
# El inquilino de cada mensaje se resuelve por el phone_number_id de Meta (tabla channel_account).
# En desarrollo lo registra el seed; para probar con Meta, usa el phone_number_id real:
SEED_PHONE_NUMBER_ID=demo-phone-number-id

# --- Mensajeria ---
# Flujo del bot (pack). Ruta relativa a la raiz del proyecto.
FLOW_PATH=packs/demo/flow.yaml
# Mensajes seguidos del mismo cliente dentro de este tiempo se procesan juntos.
INBOUND_DEBOUNCE_MS=1500
MESSAGING_WINDOW_HOURS=24
OUTBOX_MAX_ATTEMPTS=5
# Palabras que, escritas como mensaje completo, dan de baja o de alta al contacto.
OPT_OUT_KEYWORDS=BAJA,STOP
OPT_IN_KEYWORDS=ALTA,START
