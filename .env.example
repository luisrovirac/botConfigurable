# Copia a .env y ajusta. botConfigurable.bat lo crea solo, apuntando a los contenedores
# (db y redis en lugar de localhost) y con una SECRET_KEY aleatoria.
# La app valida esto al arrancar y no arranca si falta algo obligatorio.

APP_NAME=botConfigurable
# development | test | staging | production. Fuera de development/test se exige SECRET_KEY fuerte.
ENVIRONMENT=development
DEBUG=false
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Base de datos ---
# La app se conecta con un rol sin privilegios (sujeto a RLS).
DATABASE_URL=postgresql+asyncpg://bot_app:bot_app_dev@localhost:5432/botconfigurable
# Dueno de las tablas: solo para migraciones (alembic).
DATABASE_OWNER_URL=postgresql+asyncpg://user:password@localhost:5432/botconfigurable
REDIS_URL=redis://localhost:6379/0
# La contrasena de bot_app la define APP_DB_PASSWORD al levantar docker compose
# (por defecto bot_app_dev) y debe coincidir con la de DATABASE_URL.

# --- Autenticacion ---
# Fuera de development/test: al menos 32 caracteres aleatorios (openssl rand -hex 32).
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- WhatsApp Cloud API (Meta) ---
# Obligatorios. En desarrollo basta cualquier valor; el simulador firma con WHATSAPP_APP_SECRET.
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret
META_API_VERSION=v21.0
# Temporal hasta la Etapa 2: inquilino al que se asignan los mensajes entrantes.
WHATSAPP_DEFAULT_TENANT_ID=demo
