# syntax=docker/dockerfile:1

# ---------- base: Python + uv + dependencias de produccion ----------
FROM python:3.12-slim AS base

COPY --from=ghcr.io/astral-sh/uv:0.8.4 /uv /bin/uv

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/app/apps/api/src:/app/apps/worker \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

RUN useradd --uid 10001 --no-create-home app

# ---------- runtime: imagen de produccion (sin herramientas de desarrollo) ----------
FROM base AS runtime

COPY alembic.ini ./
COPY apps/api apps/api
COPY apps/worker apps/worker
COPY migrations migrations
COPY packs packs
COPY scripts scripts

USER app
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]

# ---------- dev: + ruff, mypy, pytest y los tests (desarrollo local y CI) ----------
FROM runtime AS dev

USER root
RUN uv sync --frozen --no-install-project
COPY tests tests
USER app
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "apps"]
